#version 450
#extension GL_EXT_nonuniform_qualifier : enable

//! GPU Occlusion Culling Shader - FUNCTIONAL IMPLEMENTATION
//!
//! Tests object bounding boxes against the Hi-Z pyramid and frustum planes.
//! Generates indirect draw commands for visible objects.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// STRUCTURES
// ============================================================================

struct BoundingBox {
    vec4 center;   // xyz = center, w = sphere mode flag
    vec4 extents;  // xyz = half-sizes, w = padding
};

struct ObjectData {
    BoundingBox bounds;
    mat4 model;
    uint drawIndex;
    uint firstIndex;
    uint indexCount;
    int vertexOffset;
    vec4 color;
    vec4 custom;
    uint clusterOffset;
    uint clusterCount;
    uint flags;
    uint _padding;
};

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

// ============================================================================
// DESCRIPTOR SETS (Aligned with IndirectDrawPass.rs)
// ============================================================================

// Set 0: Indirect Draw Pass Resources
layout(set = 0, binding = 1) uniform sampler2D hizPyramid;
layout(std430, set = 0, binding = 2) readonly buffer DrawTemplates {
    DrawCommand templates[];
};
layout(std430, set = 0, binding = 3) writeonly buffer VisibilityFlags {
    uint visibility[];
};
layout(std430, set = 0, binding = 4) writeonly buffer IndirectCommands {
    DrawCommand commands[];
};
layout(std430, set = 0, binding = 5) buffer VisibleCount {
    uint count;
};

// Set 1: Bindless Resources (Instance/Object Data)
layout(std430, set = 1, binding = 2) readonly buffer ObjectBuffers {
    ObjectData objects[];
} object_buffers[];

// ============================================================================
// PUSH CONSTANTS
// ============================================================================

layout(push_constant) uniform PushConstants {
    mat4 viewProj;
    vec4 screenParams;  // width, height, 1/width, 1/height
    uint objectCount;
    uint hizLevels;
    uint baseIndex;
    uint indirectStart;
    uint objectBufferIndex;
} pc;

// ============================================================================
// FRUSTUM CULLING
// ============================================================================

void extractFrustumPlanes(mat4 vp, out vec4 planes[6]) {
    // Extract planes from view-projection matrix (Row addition/subtraction)
    // Row 0 = X, Row 1 = Y, Row 2 = Z, Row 3 = W
    vec4 r0 = vec4(vp[0].x, vp[1].x, vp[2].x, vp[3].x);
    vec4 r1 = vec4(vp[0].y, vp[1].y, vp[2].y, vp[3].y);
    vec4 r2 = vec4(vp[0].z, vp[1].z, vp[2].z, vp[3].z);
    vec4 r3 = vec4(vp[0].w, vp[1].w, vp[2].w, vp[3].w);

    planes[0] = r3 + r0; // Left
    planes[1] = r3 - r0; // Right
    planes[2] = r3 + r1; // Bottom
    planes[3] = r3 - r1; // Top
    planes[4] = r2;      // Near (Vulkan [0,1] depth: z >= 0)
    planes[5] = r3 - r2; // Far
    
    // Normalize
    for (int i = 0; i < 6; i++) {
        float len = length(planes[i].xyz);
        if (len > 0.0001) {
            planes[i] /= len;
        }
    }
}

bool frustumCull(vec3 center, vec3 extents, vec4 planes[6]) {
    for (int i = 0; i < 6; i++) {
        vec3 normal = planes[i].xyz;
        float dist = planes[i].w;
        
        // Positive vertex test
        vec3 positiveVertex = center + extents * sign(normal);
        
        if (dot(normal, positiveVertex) + dist < 0.0) {
            return true; // Culled
        }
    }
    return false;
}

// ============================================================================
// OCCLUSION CULLING
// ============================================================================

bool occlusionCull(vec3 center, vec3 extents, mat4 vp) {
    // Transform 8 corners to clip space
    vec3 corners[8] = vec3[8](
        center + vec3(-extents.x, -extents.y, -extents.z),
        center + vec3( extents.x, -extents.y, -extents.z),
        center + vec3( extents.x,  extents.y, -extents.z),
        center + vec3(-extents.x,  extents.y, -extents.z),
        center + vec3(-extents.x, -extents.y,  extents.z),
        center + vec3( extents.x, -extents.y,  extents.z),
        center + vec3( extents.x,  extents.y,  extents.z),
        center + vec3(-extents.x,  extents.y,  extents.z)
    );
    
    vec2 minScreen = vec2(1.0);
    vec2 maxScreen = vec2(0.0);
    float minZ = 1.0;
    
    for (int i = 0; i < 8; i++) {
        vec4 clip = vp * vec4(corners[i], 1.0);
        
        if (clip.w <= 0.0) {
            return false; // Behind camera - conservative visible
        }
        
        vec3 ndc = clip.xyz / clip.w;
        vec2 screen = ndc.xy * 0.5 + 0.5;
        
        minScreen = min(minScreen, screen);
        maxScreen = max(maxScreen, screen);
        minZ = min(minZ, ndc.z);
    }
    
    minScreen = clamp(minScreen, vec2(0.0), vec2(1.0));
    maxScreen = clamp(maxScreen, vec2(0.0), vec2(1.0));
    
    // Calculate Hi-Z mip level
    vec2 screenSize = (maxScreen - minScreen) * pc.screenParams.xy;
    float mipLevel = ceil(log2(max(screenSize.x, screenSize.y)));
    mipLevel = clamp(mipLevel, 0.0, float(pc.hizLevels - 1));
    
    // Sample Hi-Z depth
    float hizDepth = textureLod(hizPyramid, (minScreen + maxScreen) * 0.5, mipLevel).r;
    
    // Occluded if object's nearest point is behind Hi-Z depth
    return minZ > hizDepth;
}

// ============================================================================
// MAIN
// ============================================================================

void main() {
    uint objectIdx = gl_GlobalInvocationID.x;
    
    if (objectIdx >= pc.objectCount) {
        return;
    }
    
    // Fetch object data from bindless buffer array
    ObjectData obj = object_buffers[nonuniformEXT(pc.objectBufferIndex)].objects[pc.baseIndex + objectIdx];
    
    // Transform to world space
    vec3 worldCenter = (obj.model * vec4(obj.bounds.center.xyz, 1.0)).xyz;
    vec3 worldExtents;
    
    bool isSphere = obj.bounds.center.w > 0.5;
    if (isSphere) {
        float scale = max(length(obj.model[0].xyz), max(length(obj.model[1].xyz), length(obj.model[2].xyz)));
        worldExtents = vec3(obj.bounds.extents.x * scale);
    } else {
        worldExtents = obj.bounds.extents.xyz * vec3(
            length(obj.model[0].xyz),
            length(obj.model[1].xyz),
            length(obj.model[2].xyz)
        );
    }
    
    // Frustum culling
    vec4 frustumPlanes[6];
    extractFrustumPlanes(pc.viewProj, frustumPlanes);
    
    if (frustumCull(worldCenter, worldExtents, frustumPlanes)) {
        visibility[objectIdx] = 0;
        return;
    }
    
    // Occlusion culling
    if (occlusionCull(worldCenter, worldExtents, pc.viewProj)) {
        visibility[objectIdx] = 0;
        return;
    }
    
    // Object is visible - generate indirect draw command
    visibility[objectIdx] = 1;
    
    // Atomic increment visible count
    uint visibleIndex = atomicAdd(count, 1);
    
    // Fetch template command
    DrawCommand drawTemplate = templates[obj.drawIndex];
    
    // Build indirect command
    DrawCommand cmd;
    cmd.indexCount = (obj.indexCount > 0) ? obj.indexCount : drawTemplate.indexCount;
    cmd.instanceCount = 1;
    cmd.firstIndex = (obj.firstIndex > 0) ? obj.firstIndex : drawTemplate.firstIndex;
    cmd.vertexOffset = (obj.vertexOffset != 0) ? obj.vertexOffset : drawTemplate.vertexOffset;
    cmd.firstInstance = pc.baseIndex + objectIdx;
    
    // Write to indirect buffer
    commands[pc.indirectStart + visibleIndex] = cmd;
}
