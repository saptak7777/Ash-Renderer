#version 450

//! Temporal Super-Resolution Upscale Shader
//!
//! Performs temporal accumulation with motion-compensated reprojection.
//! Uses AABB color clamping to reduce ghosting artifacts.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input: Current frame color (render resolution)
layout(set = 0, binding = 0) uniform sampler2D currentColor;

// Input: Motion vectors (render resolution)
layout(set = 0, binding = 1) uniform sampler2D motionVectors;

// Input: Depth buffer (render resolution)
layout(set = 0, binding = 2) uniform sampler2D depthBuffer;

// Input: Previous frame history (display resolution)
layout(set = 0, binding = 3) uniform sampler2D historyBuffer;

// Output: Current frame result (display resolution)
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outputImage;

// Push constants
layout(push_constant) uniform PushConstants {
    vec2 jitter;         // Current frame jitter offset
    vec2 renderSize;     // Render resolution
    vec2 displaySize;    // Display resolution
    float historyWeight; // Blend factor (0.9 = 90% history)
    uint frameIndex;     // Frame counter
} pc;

// Sample 3x3 neighborhood for AABB computation
vec3 sampleNeighborhood(sampler2D tex, vec2 uv, vec2 texelSize, out vec3 minColor, out vec3 maxColor) {
    vec3 center = texture(tex, uv).rgb;
    
    minColor = center;
    maxColor = center;
    
    // Sample 8 neighbors
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            if (x == 0 && y == 0) continue;
            
            vec2 offset = vec2(float(x), float(y)) * texelSize;
            vec3 sample_color = texture(tex, uv + offset).rgb;
            
            minColor = min(minColor, sample_color);
            maxColor = max(maxColor, sample_color);
        }
    }
    
    return center;
}

// Clamp color to AABB (reduces ghosting)
vec3 clipToAABB(vec3 color, vec3 minBox, vec3 maxBox) {
    vec3 center = (minBox + maxBox) * 0.5;
    vec3 extents = (maxBox - minBox) * 0.5 + 0.001;
    
    vec3 offset = color - center;
    vec3 ts = abs(extents / (offset + 0.0001));
    float t = min(min(ts.x, ts.y), ts.z);
    
    if (t < 1.0) {
        return center + offset * t;
    }
    return color;
}

void main() {
    ivec2 outCoord = ivec2(gl_GlobalInvocationID.xy);
    
    if (outCoord.x >= int(pc.displaySize.x) || outCoord.y >= int(pc.displaySize.y)) {
        return;
    }
    
    // Calculate UV in display space
    vec2 displayUv = (vec2(outCoord) + 0.5) / pc.displaySize;
    
    // Calculate corresponding render UV (accounting for resolution difference)
    vec2 renderUv = displayUv;
    
    // Sample motion vector
    vec2 motion = texture(motionVectors, renderUv).xy;
    
    // Reproject to previous frame position
    vec2 historyUv = displayUv - motion;
    
    // Sample current frame color with neighbor clamping data
    vec2 texelSize = 1.0 / pc.renderSize;
    vec3 minColor, maxColor;
    vec3 currentSample = sampleNeighborhood(currentColor, renderUv, texelSize, minColor, maxColor);
    
    // Sample history with clamping
    vec3 historySample = texture(historyBuffer, historyUv).rgb;
    
    // Clamp history to current neighborhood AABB
    historySample = clipToAABB(historySample, minColor, maxColor);
    
    // Check if reprojection is valid (within screen bounds)
    float historyValid = 1.0;
    if (historyUv.x < 0.0 || historyUv.x > 1.0 || historyUv.y < 0.0 || historyUv.y > 1.0) {
        historyValid = 0.0;
    }
    
    // Adaptive blending based on motion magnitude
    float motionMag = length(motion * pc.displaySize);
    float adaptiveWeight = mix(pc.historyWeight, 0.5, clamp(motionMag * 0.1, 0.0, 0.5));
    
    // Blend current and history
    float weight = historyValid * adaptiveWeight;
    vec3 result = mix(currentSample, historySample, weight);
    
    // Output
    imageStore(outputImage, outCoord, vec4(result, 1.0));
}
