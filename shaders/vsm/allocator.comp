#version 450

// VSM Allocator Compute Shader
// Processes page requests and assigns physical pages

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input: VSM metadata
layout(set = 0, binding = 0) uniform VsmMetadata {
    uint virtual_resolution;
    uint physical_resolution;
    uint page_size;
    uint page_table_resolution;
    uint physical_page_count;
    uint frame_index;
    uint debug_flags;
    uint _padding;
} vsm;

// Input: Request buffer (read)
layout(std430, set = 0, binding = 1) buffer RequestBuffer {
    uint request_count;
    uint _padding[3];
} requests;

layout(std430, set = 0, binding = 2) buffer RequestData {
    uvec4 request_data[]; // [virtual_x, virtual_y, priority_bits, padding]
} request_entries;

// Output: Page table (write physical addresses)
layout(set = 0, binding = 3, r32ui) uniform uimage2D pageTable;

// Output: Allocation buffer
layout(std430, set = 0, binding = 4) buffer AllocationBuffer {
    uint allocation_count;
    uint _padding[3];
} allocations;

layout(std430, set = 0, binding = 5) buffer AllocationData {
    uvec4 allocation_data[]; // [virtual_x, virtual_y, physical_x, physical_y]
} allocation_entries;

// Shared: Free page pool (simple ring buffer)
layout(std430, set = 0, binding = 6) buffer FreePagePool {
    uint free_page_count;
    uint next_free_index;
    uint _padding2[2];
    uvec2 free_pages[]; // [physical_x, physical_y]
} free_pool;

// Constants
const uint INVALID_PAGE = 0xFFFFFFFF;

// Pack physical coordinates into a single uint
uint packPhysicalCoords(uint x, uint y) {
    return (y << 16) | x;
}

// Unpack physical coordinates
uvec2 unpackPhysicalCoords(uint packed) {
    return uvec2(packed & 0xFFFF, packed >> 16);
}

void main() {
    uint requestIndex = gl_GlobalInvocationID.x;
    
    // Early exit if beyond request count
    if (requestIndex >= requests.request_count) {
        return;
    }
    
    // Load request
    uvec4 request = request_entries.request_data[requestIndex];
    uint virtual_x = request.x;
    uint virtual_y = request.y;
    float priority = uintBitsToFloat(request.z);
    
    ivec2 virtualPage = ivec2(virtual_x, virtual_y);
    
    // Check if page is already allocated (race condition check)
    uint existingEntry = imageLoad(pageTable, virtualPage).r;
    if (existingEntry != INVALID_PAGE) {
        // Already allocated by another thread
        return;
    }
    
    // Try to allocate a free physical page
    uint freeIndex = atomicAdd(free_pool.next_free_index, 1);
    
    if (freeIndex < free_pool.free_page_count) {
        // Get physical page coordinates
        uvec2 physicalPage = free_pool.free_pages[freeIndex];
        uint physical_x = physicalPage.x;
        uint physical_y = physicalPage.y;
        
        // Pack physical coordinates
        uint packedPhysical = packPhysicalCoords(physical_x, physical_y);
        
        // Atomically update page table
        uint oldValue = imageAtomicCompSwap(pageTable, virtualPage, INVALID_PAGE, packedPhysical);
        
        if (oldValue == INVALID_PAGE) {
            // Successfully allocated! Record the allocation
            uint allocIndex = atomicAdd(allocations.allocation_count, 1);
            
            if (allocIndex < vsm.physical_page_count) {
                allocation_entries.allocation_data[allocIndex] = uvec4(
                    virtual_x,
                    virtual_y,
                    physical_x,
                    physical_y
                );
            }
        } else {
            // Another thread won the race, return the physical page to pool
            // (This is simplified - a real implementation would need a proper free list)
            atomicAdd(free_pool.next_free_index, -1);
        }
    }
    // If no free pages, the request is dropped (could implement LRU eviction here)
}
