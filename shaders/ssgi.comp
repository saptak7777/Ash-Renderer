#version 450

//! Screen-Space Global Illumination Shader
//!
//! Computes indirect lighting by ray marching in screen space.
//! Uses depth buffer for geometry and temporal accumulation for stability.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input buffers
layout(set = 0, binding = 0) uniform sampler2D depthBuffer;
layout(set = 0, binding = 1) uniform sampler2D normalBuffer;
layout(set = 0, binding = 2) uniform sampler2D albedoBuffer;
layout(set = 0, binding = 3) uniform sampler2D historyBuffer;

// Output
layout(set = 0, binding = 4, r11f_g11f_b10f) uniform writeonly image2D giOutput;

// Push constants
layout(push_constant) uniform PushConstants {
    mat4 invViewProj;     // Inverse view-projection
    vec2 screenSize;      // GI resolution
    uint rayCount;        // Number of rays per pixel
    uint stepCount;       // Steps per ray
    float maxDistance;    // Max ray distance
    float intensity;      // GI intensity
    uint frameIndex;      // For temporal jitter
    float historyWeight;  // Temporal blend factor
} pc;

// Constants
const float PI = 3.14159265359;

// Pseudo-random number generator (Wang hash)
uint wang_hash(uint seed) {
    seed = (seed ^ 61u) ^ (seed >> 16u);
    seed *= 9u;
    seed = seed ^ (seed >> 4u);
    seed *= 0x27d4eb2du;
    seed = seed ^ (seed >> 15u);
    return seed;
}

float random(inout uint seed) {
    seed = wang_hash(seed);
    return float(seed) / 4294967295.0;
}

// Get world position from depth
vec3 getWorldPos(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = pc.invViewProj * clipPos;
    return worldPos.xyz / worldPos.w;
}

// Get screen-space direction from world direction
vec2 projectDirection(vec3 worldPos, vec3 worldDir) {
    vec4 endClip = pc.invViewProj * vec4(worldPos + worldDir, 1.0);
    vec2 endNDC = endClip.xy / endClip.w;
    
    vec4 startClip = pc.invViewProj * vec4(worldPos, 1.0);
    vec2 startNDC = startClip.xy / startClip.w;
    
    return normalize(endNDC - startNDC);
}

// Cosine-weighted hemisphere sampling
vec3 cosineWeightedHemisphere(vec3 normal, inout uint seed) {
    float u1 = random(seed);
    float u2 = random(seed);
    
    float r = sqrt(u1);
    float theta = 2.0 * PI * u2;
    
    vec3 tangent = normalize(cross(normal, abs(normal.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0)));
    vec3 bitangent = cross(normal, tangent);
    
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(1.0 - u1);
    
    return normalize(tangent * x + bitangent * y + normal * z);
}

// Screen-space ray march
vec3 traceRay(vec2 startUV, vec3 worldPos, vec3 rayDir, float startDepth) {
    vec2 rayStep = rayDir.xy / float(pc.stepCount);
    float stepSize = pc.maxDistance / float(pc.stepCount);
    
    vec2 currentUV = startUV;
    float currentDepth = startDepth;
    
    for (uint i = 0; i < pc.stepCount; i++) {
        currentUV += rayStep * 0.1;  // Scale step size for screen space
        
        // Check bounds
        if (currentUV.x < 0.0 || currentUV.x > 1.0 || currentUV.y < 0.0 || currentUV.y > 1.0) {
            break;
        }
        
        float sampleDepth = texture(depthBuffer, currentUV).r;
        
        // Hit test: ray is behind surface
        if (sampleDepth < currentDepth && currentDepth - sampleDepth < 0.01) {
            // Return albedo at hit point as indirect lighting
            return texture(albedoBuffer, currentUV).rgb;
        }
        
        currentDepth += stepSize * 0.001;  // Advance ray in depth
    }
    
    return vec3(0.0);  // No hit
}

void main() {
    ivec2 fragCoord = ivec2(gl_GlobalInvocationID.xy);
    
    if (fragCoord.x >= int(pc.screenSize.x) || fragCoord.y >= int(pc.screenSize.y)) {
        return;
    }
    
    vec2 uv = (vec2(fragCoord) + 0.5) / pc.screenSize;
    
    // Sample G-buffer
    float depth = texture(depthBuffer, uv).r;
    vec3 normal = texture(normalBuffer, uv).rgb * 2.0 - 1.0;
    vec3 albedo = texture(albedoBuffer, uv).rgb;
    
    // Skip sky pixels
    if (depth >= 1.0) {
        imageStore(giOutput, fragCoord, vec4(0.0));
        return;
    }
    
    // Reconstruct world position
    vec3 worldPos = getWorldPos(uv, depth);
    
    // Initialize RNG with pixel and frame seed
    uint seed = uint(fragCoord.x) + uint(fragCoord.y) * uint(pc.screenSize.x) + pc.frameIndex * 1000003u;
    
    // Accumulate indirect lighting
    vec3 indirect = vec3(0.0);
    
    for (uint ray = 0; ray < pc.rayCount; ray++) {
        // Generate random ray direction in hemisphere
        vec3 rayDir = cosineWeightedHemisphere(normal, seed);
        
        // Trace ray in screen space
        vec3 hitColor = traceRay(uv, worldPos, rayDir, depth);
        indirect += hitColor;
    }
    
    indirect /= float(pc.rayCount);
    indirect *= albedo;  // Modulate by surface albedo
    indirect *= pc.intensity;
    
    // Temporal accumulation
    vec3 history = texture(historyBuffer, uv).rgb;
    vec3 result = mix(indirect, history, pc.historyWeight);
    
    imageStore(giOutput, fragCoord, vec4(result, 1.0));
}
