#version 460
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D input_img;
layout(binding = 1, rgba16f) uniform writeonly image2D output_img;

layout(push_constant) uniform PushConstants {
    float strength;
    float edge_threshold;
    float adaptive;
    vec4 _padding;
} pc;

// Constants
const float MAX_HALF_FLOAT = 65504.0;
const float MIN_EDGE_THRESHOLD = 0.001;
const float EPSILON = 0.0001;

// Helper functions
bool IsSafe(float x) {
    return !isnan(x) && !isinf(x);
}

vec3 SafeColor(vec3 color) {
    // Clamp to valid range for R16G16B16A16_SFLOAT
    vec3 clamped = clamp(color, vec3(0.0), vec3(MAX_HALF_FLOAT));
    
    // Replace NaN/Inf with neutral gray as a base safety measure.
    // The main loop will attempt more sophisticated neighbor-averaging if needed.
    vec3 result = clamped;
    if (isnan(clamped.r) || isinf(clamped.r)) result.r = 0.5;
    if (isnan(clamped.g) || isinf(clamped.g)) result.g = 0.5;
    if (isnan(clamped.b) || isinf(clamped.b)) result.b = 0.5;
    
    return result;
}

float luminance(vec3 color) {
    return dot(color, vec3(0.299, 0.587, 0.114));
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(output_img);

    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    vec2 texel_size = 1.0 / vec2(size);
    vec2 uv = (vec2(coord) + 0.5) * texel_size;

    // Sample center and neighbors
    vec3 c = texture(input_img, uv).rgb;
    vec3 n = texture(input_img, uv + vec2(0, texel_size.y)).rgb;
    vec3 s = texture(input_img, uv + vec2(0, -texel_size.y)).rgb;
    vec3 e = texture(input_img, uv + vec2(texel_size.x, 0)).rgb;
    vec3 w = texture(input_img, uv + vec2(-texel_size.x, 0)).rgb;
    vec3 ne = texture(input_img, uv + vec2(texel_size.x, texel_size.y)).rgb;
    vec3 nw = texture(input_img, uv + vec2(-texel_size.x, texel_size.y)).rgb;
    vec3 se = texture(input_img, uv + vec2(texel_size.x, -texel_size.y)).rgb;
    vec3 sw = texture(input_img, uv + vec2(-texel_size.x, -texel_size.y)).rgb;

    // Sanitize 8 neighbors first so they can be used for fallback safely
    vec3 sn = SafeColor(n);
    vec3 ss = SafeColor(s);
    vec3 se_curr = SafeColor(e);
    vec3 sw_curr = SafeColor(w);
    vec3 sne = SafeColor(ne);
    vec3 snw = SafeColor(nw);
    vec3 sse = SafeColor(se);
    vec3 ssw = SafeColor(sw);

    // Sanitize center with Neighbor Average Fallback (Option B)
    vec3 sc = c;
    if (isnan(c.r) || isinf(c.r) || isnan(c.g) || isinf(c.g) || isnan(c.b) || isinf(c.b)) {
        sc = (sn + ss + se_curr + sw_curr) * 0.25;
    }
    sc = SafeColor(sc); // Final safety pass (clamping)

    // Calculate luminance using sanitized samples
    float luma_c = luminance(sc);
    float luma_n = luminance(sn);
    float luma_s = luminance(ss);
    float luma_e = luminance(se_curr);
    float luma_w = luminance(sw_curr);
    float luma_ne = luminance(sne);
    float luma_nw = luminance(snw);
    float luma_se = luminance(sse);
    float luma_sw = luminance(ssw);

    // Calculate local contrast
    float max_luma = max(max(max(luma_n, luma_s), max(luma_e, luma_w)), 
                       max(max(luma_ne, luma_nw), max(luma_se, luma_sw)));
    float min_luma = min(min(min(luma_n, luma_s), min(luma_e, luma_w)), 
                       min(min(luma_ne, luma_nw), min(luma_se, luma_sw)));
    float contrast = max_luma - min_luma;

    // Guard against NaN/Inf in contrast
    if (!IsSafe(contrast)) {
        contrast = 0.0;
    }

    // Adaptive strength
    float adaptive_strength = pc.strength;
    if (pc.adaptive > 0.5) {
        adaptive_strength *= smoothstep(0.0, 0.15, contrast);
    }

    // Guard against NaN/Inf in adaptive_strength
    if (!IsSafe(adaptive_strength)) {
        adaptive_strength = pc.strength;
    }

    // Clamp edge_threshold to minimum safe value
    float safe_edge_threshold = max(pc.edge_threshold, MIN_EDGE_THRESHOLD);

    // Edge-aware weights
    float weight_n = exp(-abs(luma_n - luma_c) / safe_edge_threshold);
    float weight_s = exp(-abs(luma_s - luma_c) / safe_edge_threshold);
    float weight_e = exp(-abs(luma_e - luma_c) / safe_edge_threshold);
    float weight_w = exp(-abs(luma_w - luma_c) / safe_edge_threshold);
    float weight_ne = exp(-abs(luma_ne - luma_c) / safe_edge_threshold);
    float weight_nw = exp(-abs(luma_nw - luma_c) / safe_edge_threshold);
    float weight_se = exp(-abs(luma_se - luma_c) / safe_edge_threshold);
    float weight_sw = exp(-abs(luma_sw - luma_c) / safe_edge_threshold);

    // Guard against NaN/Inf in weights
    if (!IsSafe(weight_n)) weight_n = 0.0;
    if (!IsSafe(weight_s)) weight_s = 0.0;
    if (!IsSafe(weight_e)) weight_e = 0.0;
    if (!IsSafe(weight_w)) weight_w = 0.0;
    if (!IsSafe(weight_ne)) weight_ne = 0.0;
    if (!IsSafe(weight_nw)) weight_nw = 0.0;
    if (!IsSafe(weight_se)) weight_se = 0.0;
    if (!IsSafe(weight_sw)) weight_sw = 0.0;

    float total_weight = weight_n + weight_s + weight_e + weight_w + 
                        weight_ne + weight_nw + weight_se + weight_sw;

    // Add epsilon to prevent division by zero
    total_weight = max(total_weight, EPSILON);

    // Calculate blurred
    vec3 blurred = (sn * weight_n + ss * weight_s + se_curr * weight_e + sw_curr * weight_w +
                   sne * weight_ne + snw * weight_nw + sse * weight_se + ssw * weight_sw) / 
                  total_weight;

    // Apply unsharp mask
    vec3 sharpened = sc + (sc - blurred) * adaptive_strength;

    // Final clamp to valid range
    sharpened = clamp(sharpened, vec3(0.0), vec3(MAX_HALF_FLOAT));

    imageStore(output_img, coord, vec4(sharpened, 1.0));
}
