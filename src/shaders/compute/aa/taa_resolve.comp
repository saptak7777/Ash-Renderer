#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D u_Result;
layout(set = 0, binding = 1) uniform sampler2D u_Color;   // Current (Jittered)
layout(set = 0, binding = 2) uniform sampler2D u_Depth;
layout(set = 0, binding = 3) uniform sampler2D u_Motion;
layout(set = 0, binding = 4) uniform sampler2D u_History; // Previous Resolved

layout(push_constant) uniform Constants {
    vec2 resolution;
    vec2 jitter;      // Current (Pixels)
    vec2 prev_jitter; // Previous (Pixels)
    float blend_factor;
    float clamping_gamma;
    float depth_threshold;
    uint anti_flicker;
} pc;

// Reversible Tonemap (Hides Fireflies and prevents Variance Box explosion)
vec3 ToneMap(vec3 c) {
    return c / (1.0 + max(c.r, max(c.g, c.b)));
}

vec3 UnToneMap(vec3 c) {
    return c / max(1.0 - max(c.r, max(c.g, c.b)), 0.0001);
}

// RGB <-> YCoCg for improved compression in variance clipping
vec3 RGBToYCoCg(vec3 c) {
    return vec3(
        c.r * 0.25 + c.g * 0.5 + c.b * 0.25,
        c.r * 0.5 - c.b * 0.5,
        -c.r * 0.25 + c.g * 0.5 - c.b * 0.25
    );
}

vec3 YCoCgToRGB(vec3 y) {
    return vec3(
        y.x + y.y - y.z,
        y.x + y.z,
        y.x - y.y - y.z
    );
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pos, ivec2(pc.resolution)))) return;

    vec2 uv = (vec2(pos) + 0.5) / pc.resolution;

    // 1. Jitter-Compensated Reprojection
    // We must un-shift the current UV (biased by current jitter) and 
    // re-shift to history's jitter state.
    vec2 velocity = texture(u_Motion, uv).rg;
    
    // Jitter is in pixels, convert to UV space for the re-projection correction
    vec2 jitterDelta = (pc.prev_jitter - pc.jitter) / pc.resolution; 
    vec2 prevUV = uv - velocity + jitterDelta;

    // 2. Sample Current Neighborhood (Tonemapped)
    vec3 centerColor = texture(u_Color, uv).rgb;
    vec3 centerTM = ToneMap(centerColor);
    vec3 centerYCC = RGBToYCoCg(centerTM);

    // Depth-based disocclusion rejection
    float currentDepth = texture(u_Depth, uv).r;
    float prevDepth = texture(u_Depth, prevUV).r;
    
    // Heuristic: if depth changes significantly, it's likely a disocclusion.
    // Using abs diff for reverse-Z stability.
    bool disoccluded = abs(currentDepth - prevDepth) > pc.depth_threshold;

    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);

    // Variance Box calculation in Tonemapped YCoCg space
    for(int x = -1; x <= 1; x++) {
        for(int y = -1; y <= 1; y++) {
            vec3 c = texture(u_Color, uv + vec2(x, y) / pc.resolution).rgb;
            c = RGBToYCoCg(ToneMap(c)); 
            m1 += c;
            m2 += c * c;
        }
    }

    vec3 mu = m1 / 9.0;
    vec3 sigma = sqrt(abs(m2 / 9.0 - mu * mu));

    // 3. Sample & Clip History (Tonemapped)
    // Check if previous UV is off-screen
    if (any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0)))) {
        imageStore(u_Result, pos, vec4(centerColor, 1.0));
        return;
    }

    vec3 history = texture(u_History, prevUV).rgb;
    vec3 historyTM = ToneMap(history);
    vec3 historyYCC = RGBToYCoCg(historyTM);

    // Variance Clip (AABB) using configurable clamping gamma
    vec3 minC = mu - pc.clamping_gamma * sigma;
    vec3 maxC = mu + pc.clamping_gamma * sigma;
    
    // Soft Clip History towards neighborhood center
    vec3 p_clip = 0.5 * (maxC + minC);
    vec3 e_clip = 0.5 * (maxC - minC) + 0.00001;
    vec3 v_clip = historyYCC - p_clip;
    vec3 v_unit = v_clip / e_clip;
    vec3 a_unit = abs(v_unit);
    float ma_unit = max(a_unit.x, max(a_unit.y, a_unit.z));
    
    if (ma_unit > 1.0) {
        historyYCC = p_clip + v_clip / ma_unit;
    }

    // 4. Resolve
    // Blend with CENTER pixel (sharper) instead of neighbourhood Mean (blurry)
    float blend = disoccluded ? 0.0 : pc.blend_factor; 

    // Anti-flicker: Reduce blend weight for samples with high variance/luminance spikes
    if (pc.anti_flicker > 0 && !disoccluded) {
        float luminanceDiff = abs(historyYCC.x - centerYCC.x);
        float flickerWeight = 1.0 / (1.0 + luminanceDiff * 4.0);
        blend *= flickerWeight;
    }

    vec3 resolvedYCC = mix(centerYCC, historyYCC, blend);
    
    // 5. Un-Tonemap and Store
    vec3 resolved = UnToneMap(YCoCgToRGB(resolvedYCC));
    
    imageStore(u_Result, pos, vec4(resolved, 1.0));
}
