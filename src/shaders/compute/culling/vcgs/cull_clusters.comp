// cull_clusters.comp — Pure BDA Cluster Culling Shader (Phase 3)
//
// Nanite-style two-phase culling: instance-level → cluster-level.
// All SSBO descriptor bindings demolished. Cluster data, visibility flags, indirect
// commands, and the draw counter are all accessed via 64-bit BDA pointers packed
// into the push constant block — matching Rust's CullingPushConstants exactly.
#version 460
#extension GL_EXT_buffer_reference2         : require
#extension GL_EXT_scalar_block_layout       : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_GOOGLE_include_directive      : require

// Suppress the global bindless texture/sampler arrays and the graphics push constant.
// This compute pipeline uses its own dedicated push constant block.
#define SKIP_PUSH_CONSTANTS
#define SKIP_GLOBAL_BINDED_RESOURCES
#include "interop/structures.glsl"

layout(local_size_x = 64) in;

// ============================================================================
// CLUSTER DATA STRUCTURE
// Mirrors Rust's MeshCluster / cluster upload format.
// ============================================================================
struct ClusterData {
    vec4  boundingSphere; // xyz = center (object-space), w = radius
    uvec2 indexRange;     // x = firstIndex, y = indexCount
    vec2  lodInfo;        // x = errorThreshold, y = parentClusterIndex (as float)
};

// ============================================================================
// BDA BUFFER REFERENCES
// ObjectBuffer, IndirectBuffer, CountBuffer defined in structures.glsl.
// VisibilityBuffer and ClusterBuffer are culling-specific.
// ============================================================================

layout(buffer_reference, scalar) buffer VisibilityBuffer {
    uint visible[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer HiZBuffer {
    uint data[];
};

layout(buffer_reference, scalar) readonly buffer ClusterBuffer {
    ClusterData clusters[];
};

// ============================================================================
// DESCRIPTOR SETS
// Only the Hi-Z sampler remains — image samplers cannot be BDA.
// ============================================================================
// No HiZ sampler descriptor here! (Phase 3: BDA only)

// ============================================================================
// CAMERA UBO (temporary, see Phase 4 note in cull_instances.comp)
// set=0, binding=0 provides the view-projection matrix until the frame UBO
// BDA handoff is wired. This is the last non-BDA input in the culling system.
// ============================================================================
// Camera BDA layout
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer CameraBuffer {
    mat4 viewProj;
};

// ============================================================================
// PUSH CONSTANTS — mirrors Rust CullingPushConstants exactly (80 bytes)
// ============================================================================
layout(push_constant) uniform CullingPC {
    vec4     screenParams;         // width, height, 1/width, 1/height
    uint     objectCount;
    uint     totalClusterCount;    // reused `hizLevels` slot for cluster pass
    uint     baseIndex;
    uint     indirectStart;
    uint64_t objectBufferPtr;      // BDA → ObjectBuffer (InstanceData[])
    uint64_t clusterBufferPtr;     // BDA → ClusterBuffer (ClusterData[])
    uint64_t visibilityBufferPtr;  // BDA → VisibilityBuffer (uint[])
    uint64_t indirectBufferPtr;    // BDA → IndirectBuffer (IndirectDrawCommand[])
    uint64_t countBufferPtr;       // BDA → CountBuffer                @ 64
    uint64_t hizBufferPtr;         // BDA → HiZBuffer                  @ 72
    float    lodBias;              // reused `debugMode` slot          @ 80
    uint     _pad;                 //                                  @ 84
    uint64_t cameraBufferPtr;      // BDA → CameraBuffer               @ 88
} pc;

// ============================================================================
// UTILITIES
// ============================================================================

void extractFrustumPlanes(mat4 vp, out vec4 planes[6]) {
    vec4 r0 = vec4(vp[0].x, vp[1].x, vp[2].x, vp[3].x);
    vec4 r1 = vec4(vp[0].y, vp[1].y, vp[2].y, vp[3].y);
    vec4 r2 = vec4(vp[0].z, vp[1].z, vp[2].z, vp[3].z);
    vec4 r3 = vec4(vp[0].w, vp[1].w, vp[2].w, vp[3].w);
    planes[0] = r3 + r0; // Left
    planes[1] = r3 - r0; // Right
    planes[2] = r3 + r1; // Bottom
    planes[3] = r3 - r1; // Top
    planes[4] = r2;       // Near
    planes[5] = r3 - r2;  // Far
    for (int i = 0; i < 6; i++) {
        float len = length(planes[i].xyz);
        if (len > 0.0001) planes[i] /= len;
    }
}

bool isSphereInFrustum(vec3 center, float radius, vec4 planes[6]) {
    for (int i = 0; i < 6; i++) {
        if (dot(planes[i].xyz, center) + planes[i].w < -radius) return false;
    }
    return true;
}

uint get_mip_offset(uint base_width, uint base_height, uint target_mip) {
    uint offset = 0;
    for (uint i = 0; i < target_mip; i++) {
        offset += max(1u, base_width >> i) * max(1u, base_height >> i);
    }
    return offset;
}

bool isSphereOccluded(vec3 center, float radius) {
    CameraBuffer camera = CameraBuffer(pc.cameraBufferPtr);
    vec4 clip = camera.viewProj * vec4(center, 1.0);
    if (clip.w <= 0.0) return false;
    vec3 ndc = clip.xyz / clip.w;
    
    // Reverse-Z: near is 1.0, far is 0.0
    if (ndc.z < 0.0) return false;

    // Radius in clip space
    vec4 rClip = camera.viewProj * vec4(radius, 0.0, 0.0, 0.0);
    float projRadius = abs(rClip.x / clip.w);

    vec2 uv = ndc.xy * 0.5 + 0.5;
    
    // Clamp projective radius
    projRadius = min(projRadius, 1.0);
    
    float pixelRadius = projRadius * max(pc.screenParams.x, pc.screenParams.y) * 0.5;
    float max_mips = ceil(log2(max(pc.screenParams.x, pc.screenParams.y)));
    float lod  = clamp(log2(pixelRadius), 0.0, max_mips);
    uint mipLevel = uint(lod);

    uint base_width = uint(pc.screenParams.x);
    uint base_height = uint(pc.screenParams.y);
    uint offset = get_mip_offset(base_width, base_height, mipLevel);
    
    uint mip_width = max(1u, base_width >> mipLevel);
    uint mip_height = max(1u, base_height >> mipLevel);

    vec2 mipSize = vec2(mip_width, mip_height);
    vec2 pMin = clamp(uv - vec2(projRadius), vec2(0.0), vec2(1.0)) * mipSize;
    vec2 pMax = clamp(uv + vec2(projRadius), vec2(0.0), vec2(1.0)) * mipSize;

    uint x0 = uint(clamp(floor(pMin.x), 0.0, mipSize.x - 1.0));
    uint y0 = uint(clamp(floor(pMin.y), 0.0, mipSize.y - 1.0));
    uint x1 = uint(clamp(ceil(pMax.x), 0.0, mipSize.x - 1.0));
    uint y1 = uint(clamp(ceil(pMax.y), 0.0, mipSize.y - 1.0));

    if (pc.hizBufferPtr == 0ul) return false;
    HiZBuffer hiz = HiZBuffer(pc.hizBufferPtr);
    
    float d00 = uintBitsToFloat(hiz.data[offset + (y0 * mip_width) + x0]);
    float d10 = uintBitsToFloat(hiz.data[offset + (y0 * mip_width) + x1]);
    float d01 = uintBitsToFloat(hiz.data[offset + (y1 * mip_width) + x0]);
    float d11 = uintBitsToFloat(hiz.data[offset + (y1 * mip_width) + x1]);
    
    // Reverse-Z: furthest visible point is the minimum float depth
    float min_fetched_depth = min(min(d00, d10), min(d01, d11));
    
    return ndc.z < min_fetched_depth - projRadius;
}

float calculateScreenError(vec3 center, float threshold) {
    CameraBuffer camera = CameraBuffer(pc.cameraBufferPtr);
    vec4 clip = camera.viewProj * vec4(center, 1.0);
    return (threshold / max(clip.w, 0.0001)) * max(pc.screenParams.x, pc.screenParams.y);
}

// ============================================================================
// MAIN
// ============================================================================

void main() {
    uint clusterIdx = gl_GlobalInvocationID.x;
    if (clusterIdx >= pc.totalClusterCount) return;

    // Null-pointer guard
    if (pc.objectBufferPtr  == 0ul) return;
    if (pc.clusterBufferPtr == 0ul) return;

    // Instantiate typed BDA handles from raw pointers
    ObjectBuffer    objBuf  = ObjectBuffer(pc.objectBufferPtr);
    ClusterBuffer   clsBuf  = ClusterBuffer(pc.clusterBufferPtr);
    VisibilityBuffer visBuf = VisibilityBuffer(pc.visibilityBufferPtr);
    IndirectBuffer   cmdBuf = IndirectBuffer(pc.indirectBufferPtr);
    CountBuffer      cntBuf = CountBuffer(pc.countBufferPtr);

    // --- Find parent object (O(N) scan; acceptable for cluster counts < 65k) ---
    uint objIdx    = 0u;
    uint clusterBase = 0u;
    for (uint i = 0u; i < pc.objectCount; i++) {
        // InstanceData stores cluster count in `index_count` for cluster-mode meshes.
        uint cnt = objBuf.objects[i].index_count;
        if (clusterIdx < clusterBase + cnt) {
            objIdx = i;
            break;
        }
        clusterBase += cnt;
    }

    InstanceData obj = objBuf.objects[objIdx];
    if ((obj.flags & 1u) == 0u) {
        visBuf.visible[clusterIdx] = 0u;
        return;
    }

    uint localIdx     = clusterIdx - clusterBase;
    ClusterData cluster = clsBuf.clusters[obj.draw_index + localIdx];

    // Transform cluster bounding sphere to world space
    vec3  worldCenter = (obj.model * vec4(cluster.boundingSphere.xyz, 1.0)).xyz;
    float worldRadius = cluster.boundingSphere.w * length(obj.model[0].xyz);

    // 1. Frustum Culling
    CameraBuffer camera = CameraBuffer(pc.cameraBufferPtr);
    vec4 planes[6];
    extractFrustumPlanes(camera.viewProj, planes);
    if (!isSphereInFrustum(worldCenter, worldRadius, planes)) {
        visBuf.visible[clusterIdx] = 0u;
        return;
    }

    // 2. Hi-Z Occlusion Culling
    if (isSphereOccluded(worldCenter, worldRadius)) {
        visBuf.visible[clusterIdx] = 0u;
        return;
    }

    // 3. LOD Selection (Nanite-style screen-space error)
    float error = calculateScreenError(worldCenter, cluster.lodInfo.x);
    if (error < pc.lodBias) {
        visBuf.visible[clusterIdx] = 0u;
        return;
    }

    // --- VISIBLE: write output via BDA ---
    visBuf.visible[clusterIdx] = 1u;
    uint slot = atomicAdd(cntBuf.count, 1u);

    IndirectDrawCommand cmd;
    cmd.vertexCount   = cluster.indexRange.y;
    cmd.instanceCount = 1u;
    cmd.firstVertex   = cluster.indexRange.x;
    cmd.firstInstance = objIdx;
    cmdBuf.commands[slot] = cmd;
}
