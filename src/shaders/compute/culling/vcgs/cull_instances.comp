// cull_instances.comp — Pure BDA Occlusion Culling Shader (Phase 3)
//
// Push constant layout (80 bytes, 48 bytes free vs. 128-byte Vulkan minimum):
//   screen_params           [f32;4]  @ offset 0
//   object_count            u32      @ offset 16
//   hiz_levels              u32      @ offset 20
//   base_index              u32      @ offset 24
//   indirect_start          u32      @ offset 28
//   object_buffer_addr      u64      @ offset 32  (BDA)
//   cluster_buffer_addr     u64      @ offset 40  (BDA, reserved)
//   visibility_buffer_addr  u64      @ offset 48  (BDA)
//   indirect_buffer_addr    u64      @ offset 56  (BDA)
//   count_buffer_addr       u64      @ offset 64  (BDA)
//   debug_mode              u32      @ offset 72
//   _pad                    u32      @ offset 76
#version 450
#extension GL_EXT_nonuniform_qualifier                   : enable
#extension GL_GOOGLE_include_directive                   : require
#extension GL_EXT_buffer_reference2                      : require
#extension GL_EXT_scalar_block_layout                    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#define SKIP_PUSH_CONSTANTS
#define SKIP_GLOBAL_BINDED_RESOURCES
#include "interop/structures.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// DESCRIPTOR SETS — only the Hi-Z sampler and camera UBO remain.
// Image samplers cannot be BDA. The camera UBO will be converted in Phase 4
// once the FrameData BDA handoff is wired to the compute pipeline.
// ============================================================================

// Camera BDA layout
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer CameraBuffer {
    mat4 model;
    mat4 view;
    mat4 projection;
    mat4 viewProj;
};

// No HiZ sampler descriptor here! (Phase 3: BDA only)

// ============================================================================
// BDA BUFFER REFERENCES
// ObjectBuffer and IndirectBuffer and CountBuffer come from structures.glsl.
// VisibilityBuffer is culling-specific.
// ============================================================================

layout(buffer_reference, scalar) buffer VisibilityBuffer {
    uint visibility[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer HiZBuffer {
    uint data[];
};

// ============================================================================
// PUSH CONSTANTS — mirrors Rust CullingPushConstants exactly (80 bytes)
// ============================================================================

layout(push_constant) uniform CullingPC {
    vec4     screenParams;         // width, height, 1/width, 1/height  @ 0
    uint     objectCount;          //                                    @ 16
    uint     hizLevels;            //                                    @ 20
    uint     baseIndex;            //                                    @ 24
    uint     indirectStart;        //                                    @ 28
    uint64_t objectBufferPtr;      // BDA → ObjectBuffer                @ 32
    uint64_t clusterBufferPtr;     // BDA → (unused in instance pass)   @ 40
    uint64_t visibilityBufferPtr;  // BDA → VisibilityBuffer            @ 48
    uint64_t indirectBufferPtr;    // BDA → IndirectBuffer              @ 56
    uint64_t countBufferPtr;       // BDA → CountBuffer                 @ 64
    uint64_t hizBufferPtr;         // BDA → HiZBuffer                   @ 72
    uint     debugMode;            //                                    @ 80
    uint     _pad;                 //                                    @ 84
    uint64_t cameraBufferPtr;      // BDA → CameraBuffer                 @ 88
} pc;

// ============================================================================
// FRUSTUM CULLING
// ============================================================================

void extractFrustumPlanes(mat4 vp, out vec4 planes[6]) {
    vec4 r0 = vec4(vp[0].x, vp[1].x, vp[2].x, vp[3].x);
    vec4 r1 = vec4(vp[0].y, vp[1].y, vp[2].y, vp[3].y);
    vec4 r2 = vec4(vp[0].z, vp[1].z, vp[2].z, vp[3].z);
    vec4 r3 = vec4(vp[0].w, vp[1].w, vp[2].w, vp[3].w);
    planes[0] = r3 + r0; // Left
    planes[1] = r3 - r0; // Right
    planes[2] = r3 + r1; // Bottom
    planes[3] = r3 - r1; // Top
    planes[4] = r2;       // Near (Reverse-Z: z >= 0)
    planes[5] = r3 - r2;  // Far
    for (int i = 0; i < 6; i++) {
        float len = length(planes[i].xyz);
        if (len > 0.0001) planes[i] /= len;
    }
}

bool frustumCullAABB(vec3 center, vec3 extents, vec4 planes[6]) {
    for (int i = 0; i < 6; i++) {
        vec3 pv = center + extents * sign(planes[i].xyz);
        if (dot(planes[i].xyz, pv) + planes[i].w < 0.0) return true;
    }
    return false;
}

bool frustumCullSphere(vec3 center, float radius, vec4 planes[6]) {
    for (int i = 0; i < 6; i++) {
        if (dot(planes[i].xyz, center) + planes[i].w < -radius) return true;
    }
    return false;
}

uint get_mip_offset(uint base_width, uint base_height, uint target_mip) {
    uint offset = 0;
    for (uint i = 0; i < target_mip; i++) {
        offset += max(1u, base_width >> i) * max(1u, base_height >> i);
    }
    return offset;
}

bool occlusionCull(vec3 center, vec3 extents, mat4 vp) {
    vec3 corners[8] = vec3[8](
        center + vec3(-extents.x, -extents.y, -extents.z),
        center + vec3( extents.x, -extents.y, -extents.z),
        center + vec3( extents.x,  extents.y, -extents.z),
        center + vec3(-extents.x,  extents.y, -extents.z),
        center + vec3(-extents.x, -extents.y,  extents.z),
        center + vec3( extents.x, -extents.y,  extents.z),
        center + vec3( extents.x,  extents.y,  extents.z),
        center + vec3(-extents.x,  extents.y,  extents.z)
    );
    vec2 minScreen = vec2(1.0);
    vec2 maxScreen = vec2(0.0);
    float maxZ = 0.0; // Reverse-Z: near = 1.0
    for (int i = 0; i < 8; i++) {
        vec4 clip = vp * vec4(corners[i], 1.0);
        if (clip.w <= 0.0) return false;
        vec3 ndc    = clip.xyz / clip.w;
        vec2 screen = ndc.xy * 0.5 + 0.5;
        minScreen = min(minScreen, screen);
        maxScreen = max(maxScreen, screen);
        maxZ = max(maxZ, ndc.z);
    }
    minScreen = clamp(minScreen, vec2(0.0), vec2(1.0));
    maxScreen = clamp(maxScreen, vec2(0.0), vec2(1.0));
    vec2  screenSize = (maxScreen - minScreen) * pc.screenParams.xy;
    float lod   = clamp(ceil(log2(max(screenSize.x, screenSize.y))), 0.0, float(pc.hizLevels - 1));
    uint mipLevel = uint(lod);

    uint base_width = uint(pc.screenParams.x);
    uint base_height = uint(pc.screenParams.y);
    uint offset = get_mip_offset(base_width, base_height, mipLevel);
    
    uint mip_width = max(1u, base_width >> mipLevel);
    uint mip_height = max(1u, base_height >> mipLevel);

    vec2 mipSize = vec2(mip_width, mip_height);
    vec2 pMin = minScreen * mipSize;
    vec2 pMax = maxScreen * mipSize;

    uint x0 = uint(clamp(floor(pMin.x), 0.0, mipSize.x - 1.0));
    uint y0 = uint(clamp(floor(pMin.y), 0.0, mipSize.y - 1.0));
    uint x1 = uint(clamp(ceil(pMax.x), 0.0, mipSize.x - 1.0));
    uint y1 = uint(clamp(ceil(pMax.y), 0.0, mipSize.y - 1.0));

    if (pc.hizBufferPtr == 0ul) return false;
    HiZBuffer hiz = HiZBuffer(pc.hizBufferPtr);
    
    float d00 = uintBitsToFloat(hiz.data[offset + (y0 * mip_width) + x0]);
    float d10 = uintBitsToFloat(hiz.data[offset + (y0 * mip_width) + x1]);
    float d01 = uintBitsToFloat(hiz.data[offset + (y1 * mip_width) + x0]);
    float d11 = uintBitsToFloat(hiz.data[offset + (y1 * mip_width) + x1]);
    
    // Reverse-Z: furthest visible point is the minimum float depth
    float min_fetched_depth = min(min(d00, d10), min(d01, d11));
    
    return maxZ < min_fetched_depth;
}

// ============================================================================
// MAIN
// ============================================================================

void main() {
    uint objectIdx = gl_GlobalInvocationID.x;

    // BDA null-pointer guard
    if (pc.objectBufferPtr == 0ul || pc.visibilityBufferPtr == 0ul) return;
    if (objectIdx >= pc.objectCount) return;

    // Instantiate typed handles from raw 64-bit pointers
    ObjectBuffer     objBuf = ObjectBuffer(pc.objectBufferPtr);
    VisibilityBuffer visBuf = VisibilityBuffer(pc.visibilityBufferPtr);
    IndirectBuffer   cmdBuf = IndirectBuffer(pc.indirectBufferPtr);
    CountBuffer      cntBuf = CountBuffer(pc.countBufferPtr);
    CameraBuffer     camera = CameraBuffer(pc.cameraBufferPtr);

    // Fetch object data — pure BDA read, no descriptor binding
    InstanceData obj = objBuf.objects[pc.baseIndex + objectIdx];

    // Transform bounds to world space
    vec3  worldCenter  = (obj.model * vec4(obj.bounds_center.xyz, 1.0)).xyz;
    float worldRadius  = 0.0;
    vec3  worldExtents;
    bool  isSphere     = obj.bounds_center.w > 0.5;

    if (isSphere) {
        float scale    = max(length(obj.model[0].xyz), max(length(obj.model[1].xyz), length(obj.model[2].xyz)));
        worldRadius    = obj.bounds_extents.x * scale;
        worldExtents   = vec3(worldRadius);
    } else {
        worldExtents = obj.bounds_extents.xyz * vec3(
            length(obj.model[0].xyz),
            length(obj.model[1].xyz),
            length(obj.model[2].xyz)
        );
    }

    // Frustum culling using camera UBO (Phase 4: will become FrameData BDA)
    vec4 frustumPlanes[6];
    extractFrustumPlanes(camera.viewProj, frustumPlanes);

    bool culled = isSphere
        ? frustumCullSphere(worldCenter, worldRadius, frustumPlanes)
        : frustumCullAABB(worldCenter, worldExtents, frustumPlanes);

    if (culled) { visBuf.visibility[objectIdx] = 0u; return; }

    // Screen-size culling: reject sub-pixel geometry
    vec4  clipPos   = camera.viewProj * vec4(worldCenter, 1.0);
    float clipW     = clipPos.w;
    float boundRad  = max(worldExtents.x, max(worldExtents.y, worldExtents.z));
    if (clipW > 0.0001 && (boundRad / clipW) < 0.005) {
        visBuf.visibility[objectIdx] = 0u;
        return;
    }

    // Nanite LOD selection (The Cut)
    float parentError = 1000000.0;
    if (obj.parent_index != 0xFFFFFFFFu && obj.parent_index < pc.objectCount) {
        InstanceData parent = objBuf.objects[obj.parent_index];
        parentError = parent.error_metric;
    }
    float dist           = max(clipW, 0.0001);
    float errorThreshold = dist * 0.002;
    bool  isSelected     = (obj.error_metric <= errorThreshold) && (parentError > errorThreshold);
    if (!isSelected) { visBuf.visibility[objectIdx] = 0u; return; }

    // Hi-Z occlusion culling
    if (occlusionCull(worldCenter, worldExtents, camera.viewProj)) {
        visBuf.visibility[objectIdx] = 0u;
        return;
    }

    // VISIBLE — write output via BDA pointers only
    visBuf.visibility[objectIdx] = 1u;
    uint slot = atomicAdd(cntBuf.count, 1u);

    IndirectDrawCommand cmd;
    cmd.vertexCount   = obj.index_count;
    cmd.instanceCount = 1u;
    cmd.firstVertex   = obj.first_index;
    cmd.firstInstance = pc.baseIndex + objectIdx;
    cmdBuf.commands[pc.indirectStart + slot] = cmd;
}
