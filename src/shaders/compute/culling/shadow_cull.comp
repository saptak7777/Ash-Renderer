#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

//! GPU Shadow Culling Shader
//!
//! Performs frustum culling for shadow casters against a light-space view-projection.
//! Generates indirect draw commands for visible objects.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "interop/structures.glsl"
#include "common/culling.glsl"

// ============================================================================
// MAIN
// ============================================================================

void main() {
    uint objectIdx = gl_GlobalInvocationID.x;
    
    // instance_ptr: BDA Pointer to InstanceData array
    // material_index: objectCount
    if (push.instance_ptr == 0 || objectIdx >= push.object_count) {
        return;
    }
    
    // Fetch instance data via BDA
    InstanceBuffer obj_buffer = InstanceBuffer(push.instance_ptr);
    InstanceData obj = obj_buffer.instances[push.base_index + objectIdx];
    
    // Skip if not a shadow caster (bit 0 = CAST_SHADOWS; see culling.rs CULL_FLAG_CAST_SHADOWS)
    if ((obj.flags & 1) == 0) {
        return;
    }

    // Transform bounds to world space
    vec3 worldCenter = (obj.model * vec4(obj.bounds_center.xyz, 1.0)).xyz;
    bool isSphere = obj.bounds_center.w > 0.5;
    
    // vsm_ptr: Optional pointer to VsmGlobal for viewProj matrices
    VsmGlobal vsm = VsmGlobal(push.vsm_ptr);
    mat4 viewProj = vsm.light_view_projections[push.clipmap_level];
    
    vec4 frustumPlanes[6];
    extractFrustumPlanes(viewProj, frustumPlanes);
    
    bool culled = false;
    if (isSphere) {
        float scale = max(length(obj.model[0].xyz), max(length(obj.model[1].xyz), length(obj.model[2].xyz)));
        float worldRadius = obj.bounds_extents.x * scale;
        culled = frustumCullSphere(worldCenter, worldRadius, frustumPlanes);
    } else {
        vec3 worldExtents = obj.bounds_extents.xyz * vec3(
            length(obj.model[0].xyz),
            length(obj.model[1].xyz),
            length(obj.model[2].xyz)
        );
        culled = frustumCullAABB(worldCenter, worldExtents, frustumPlanes);
    }

    if (culled) {
        return;
    }
    
    // Visible - increment count and write command
    // light_ptr: BDA Pointer to atomic count (uint)
    CountBuffer counter = CountBuffer(push.light_ptr);
    uint visibleIndex = atomicAdd(counter.count, 1);
    
    IndirectDrawCommand cmd;
    cmd.vertexCount = obj.index_count;
    cmd.instanceCount = 1;
    cmd.firstVertex = obj.first_index; // Critical: gl_VertexIndex starts here
    cmd.firstInstance = push.base_index + objectIdx;
    
    // tile_ptr: BDA Pointer to IndirectDrawCommand array
    IndirectBuffer out_buffer = IndirectBuffer(push.tile_ptr);
    out_buffer.commands[push.indirect_start + visibleIndex] = cmd;
}
